{
  "manifest_version": 3,
  "name": "ConnectProtect",
  "version": "2.2",
  "description": "Hybrid malicious URL detection with local Edge-AI scoring, XAI trace, and Cognitive Speed Bump technology.",
  "permissions": [
    "storage",
    "tabs",
    "contextMenus"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "ConnectProtect — Malicious URL Shield"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "css": [
        "inject.css"
      ],
      "js": [
        "engine.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "Tech_bg.avif"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
